{
  "format": "podbag-course-v1",
  "id": "web-service-recovery",
  "port": 18082,
  "translations": {
    "en": {
      "title": "Podbag Training · Recover a web server with logs",
      "guide": "Start the session with podbag lab start web-service-recovery.",
      "url": "https://podbag.dev/blog/web-service-recovery/"
    },
    "ko": {
      "title": "Podbag Training · 로그로 웹 서버 장애 해결하기",
      "guide": "podbag lab start web-service-recovery 명령으로 실습을 시작합니다.",
      "url": "https://podbag.dev/ko/blog/web-service-recovery/"
    }
  },
  "steps": [
    {
      "key": "runFailed",
      "names": {
        "en": "Run the server with a missing setting",
        "ko": "설정이 빠진 웹 서버 실행하기",
        "ja": "設定が足りない状態でサーバーを起動する",
        "zh-CN": "在缺少设置时启动服务器",
        "fil": "Patakbuhin ang server na may kulang na setting",
        "es": "Inicia el servidor con un ajuste faltante",
        "vi": "Chạy máy chủ khi thiếu cấu hình"
      },
      "command": "podbag run -d --name lab-web --network none docker.io/library/busybox:1.37.0 sh -c 'if [ -z \"$SITE_TITLE\" ]; then echo \"SITE_TITLE is required\" >&2; exit 1; fi; mkdir -p /www && printf \"%s\\n\" \"$SITE_TITLE\" > /www/index.html && exec httpd -f -p 8080 -h /www'",
      "check": {
        "kind": "container-exited",
        "name": "lab-web",
        "code": 1
      }
    },
    {
      "key": "inspectFailed",
      "names": {
        "en": "Inspect the exited container in Desktop",
        "ko": "Desktop에서 종료된 컨테이너 확인하기",
        "ja": "Desktop で終了したコンテナを確認する",
        "zh-CN": "在 Desktop 中查看已退出的容器",
        "fil": "Tingnan ang humintong container sa Desktop",
        "es": "Inspecciona el contenedor detenido en Desktop",
        "vi": "Kiểm tra container đã thoát trong Desktop"
      },
      "check": {
        "kind": "desktop-inspect-exited",
        "name": "lab-web"
      }
    },
    {
      "key": "readRecoveryLogs",
      "names": {
        "en": "Read the startup error in the CLI",
        "ko": "CLI에서 시작 실패 로그 읽기",
        "ja": "CLI で起動失敗のログを読む",
        "zh-CN": "在 CLI 中读取启动错误日志",
        "fil": "Basahin ang error sa pagsisimula sa CLI",
        "es": "Lee el error de inicio en la CLI",
        "vi": "Đọc lỗi khởi động trong CLI"
      },
      "command": "podbag logs lab-web",
      "check": {
        "kind": "output-has-line",
        "text": "SITE_TITLE is required"
      }
    },
    {
      "key": "removeFailed",
      "names": {
        "en": "Remove the failed container in the CLI",
        "ko": "CLI에서 종료된 컨테이너 삭제하기",
        "ja": "CLI で失敗したコンテナを削除する",
        "zh-CN": "在 CLI 中删除失败的容器",
        "fil": "Burahin ang pumalyang container sa CLI",
        "es": "Elimina el contenedor que falló en la CLI",
        "vi": "Xóa container gặp lỗi trong CLI"
      },
      "command": "podbag rm lab-web",
      "check": {
        "kind": "container-absent",
        "name": "lab-web"
      }
    },
    {
      "key": "runFixed",
      "names": {
        "en": "Run the server with the missing setting supplied",
        "ko": "환경 변수를 설정해 서버 다시 실행하기",
        "ja": "不足している設定を追加してサーバーを起動する",
        "zh-CN": "补上缺少的设置并启动服务器",
        "fil": "Patakbuhin ang server gamit ang kailangang setting",
        "es": "Inicia el servidor con el ajuste requerido",
        "vi": "Bổ sung cấu hình và chạy lại máy chủ"
      },
      "command": "podbag run -d --name lab-web -p 127.0.0.1:{port}:8080 -e 'SITE_TITLE=Recovered Podbag site' docker.io/library/busybox:1.37.0 sh -c 'if [ -z \"$SITE_TITLE\" ]; then echo \"SITE_TITLE is required\" >&2; exit 1; fi; mkdir -p /www && printf \"%s\\n\" \"$SITE_TITLE\" > /www/index.html && exec httpd -f -p 8080 -h /www'",
      "check": {
        "kind": "container-published",
        "name": "lab-web"
      }
    },
    {
      "key": "ports",
      "names": {
        "en": "Check the ports in Practice containers",
        "ko": "실습 컨테이너에서 포트 확인하기",
        "ja": "実習コンテナでポートを確認する",
        "zh-CN": "在实验容器中查看端口",
        "fil": "Tingnan ang mga port sa Mga practice container",
        "es": "Consulta los puertos en Contenedores de práctica",
        "vi": "Kiểm tra cổng trong Container thực hành"
      },
      "check": {
        "kind": "desktop-ports",
        "name": "lab-web"
      }
    },
    {
      "key": "browser",
      "names": {
        "en": "Open the page in the browser",
        "ko": "브라우저에서 페이지 열기",
        "ja": "ブラウザーでページを開く",
        "zh-CN": "在浏览器中打开页面",
        "fil": "Buksan ang pahina sa browser",
        "es": "Abre la página en el navegador",
        "vi": "Mở trang trong trình duyệt"
      },
      "check": {
        "kind": "desktop-browser",
        "name": "lab-web",
        "page": "Recovered Podbag site"
      }
    },
    {
      "key": "stop",
      "names": {
        "en": "Stop the container in Desktop",
        "ko": "Desktop에서 컨테이너 중지하기",
        "ja": "Desktop でコンテナを停止する",
        "zh-CN": "在 Desktop 中停止容器",
        "fil": "Ihinto ang container sa Desktop",
        "es": "Detén el contenedor en Desktop",
        "vi": "Dừng container trong Desktop"
      },
      "check": {
        "kind": "desktop-stop",
        "name": "lab-web"
      }
    },
    {
      "key": "remove",
      "names": {
        "en": "Remove the container in the CLI",
        "ko": "CLI에서 컨테이너 삭제하기",
        "ja": "CLI でコンテナを削除する",
        "zh-CN": "在 CLI 中删除容器",
        "fil": "Burahin ang container sa CLI",
        "es": "Elimina el contenedor en la CLI",
        "vi": "Xóa container trong CLI"
      },
      "command": "podbag rm lab-web",
      "check": {
        "kind": "container-absent",
        "name": "lab-web"
      }
    },
    {
      "key": "finish",
      "names": {
        "en": "End the practice session",
        "ko": "실습 종료하기",
        "ja": "実習を終了する",
        "zh-CN": "结束实验",
        "fil": "Tapusin ang session",
        "es": "Termina la sesión",
        "vi": "Kết thúc phiên thực hành"
      },
      "command": "exit",
      "check": {
        "kind": "finish"
      }
    }
  ]
}
